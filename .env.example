# Neon → Project → Connect. Use the POOLED connection string (host has "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Optional: the direct (non-pooled) string, used only for migrations.
DATABASE_URL_UNPOOLED=""

# Better Auth. Generate the secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The site's public URL (http://localhost:4321 for local dev).
BETTER_AUTH_URL="http://localhost:4321"

# Only these emails can use the portal (comma separated).
ADMIN_EMAILS="justinedlimguis@gmail.com"

# Shared secret for n8n → POST /api/posts. At least 32 chars:  openssl rand -hex 32
INGEST_API_KEY=""

# Link used by the portal's "New post" button.
TOPIC_FORM_URL="https://jl-labs.up.railway.app/form/byjustine-new-post"

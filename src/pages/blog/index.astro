---
import PostCard from "../../components/PostCard.astro";
import Layout from "../../layouts/Layout.astro";
import { listPublishedPosts } from "../../lib/posts";

export const prerender = false;

const posts = await listPublishedPosts();
const [featured, ...rest] = posts;

Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=600");
---

<Layout
title="Blog"
description="Thoughts on AI, automation and software by Justine.">

<section class="mx-auto max-w-5xl px-6 py-16 sm:py-20">

<header class="max-w-2xl">

<p class="text-xs font-bold uppercase tracking-[.3em] text-[#ffe4e1]">
Writing
</p>

<h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">
Blog
</h1>

<p class="mt-5 leading-7 text-slate-400">
Thoughts on AI, automation and software — plus the rabbit holes in between.
</p>

{posts.length > 0 && (
<p class="mt-5 text-xs text-slate-500">
{posts.length} {posts.length === 1 ? "post" : "posts"}
</p>
)}

</header>

<div class="my-12 h-px bg-white/10"></div>

{posts.length === 0 ? (

<p class="rounded-3xl border border-white/10 bg-white/[.02] p-10 text-center text-sm text-slate-400">
No posts published yet. Check back soon.
</p>

) : (

<div class="space-y-6">

<PostCard post={featured} featured />

{rest.length > 0 && (
<div class="grid gap-6 sm:grid-cols-2">
{rest.map((post) => <PostCard post={post} />)}
</div>
)}

</div>

)}

</section>

</Layout>

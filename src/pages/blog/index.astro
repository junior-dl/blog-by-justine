---
import Layout from "../../layouts/Layout.astro";
import { listPublishedPosts } from "../../lib/posts";

export const prerender = false;

const posts = await listPublishedPosts();

Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=600");
---

<Layout title="Blog">

<section class="max-w-5xl mx-auto px-6 py-20">

<h1 class="text-6xl font-bold">
Blog
</h1>

<p class="mt-5 text-slate-400">
Thoughts on AI, automation and software.
</p>

<div class="space-y-8 mt-16">

{
posts.map(post=>(

<a
href={`/blog/${post.slug}/`}
class="block rounded-3xl border border-white/10 p-8 hover:border-[#ffe4e1] transition-all hover:-translate-y-1">

<h2 class="text-3xl font-bold">
{post.title}
</h2>

<p class="mt-4 text-slate-400">
{post.description}
</p>

<p class="mt-6 text-sm text-slate-500">
{post.pubDate.toDateString()}
</p>

</a>

))
}

</div>

</section>

</Layout>
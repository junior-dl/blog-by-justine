---
import PostCard from "../components/PostCard.astro";
import Layout from "../layouts/Layout.astro";
import { listPublishedPosts } from "../lib/posts";

export const prerender = false;

const latest = await listPublishedPosts(3);
const [featured, ...rest] = latest;

Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=600");
---

<Layout title="By Justine">

<section class="mx-auto max-w-5xl px-6 py-16 sm:py-20">

<p class="text-xs font-bold uppercase tracking-[.3em] text-[#ffe4e1]">
Blog
</p>

<h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">
BY JUSTINE.
</h1>

<p class="mt-5 max-w-2xl text-lg leading-8 text-slate-300">
Thoughts, projects, and rabbit holes.
</p>

<p class="mt-4 max-w-2xl leading-7 text-slate-400">
Welcome to my little corner of the internet. This is where I share what I'm building, what I'm learning, and the random topics I'm currently obsessed with - from AI and automation to nutrition, productivity, and everything in between.
</p>

{latest.length > 0 && (
<>

<div class="mt-16 flex items-center justify-between gap-4">

<h2 class="text-xl font-semibold sm:text-2xl">
Latest Posts
</h2>

<a
href="/blog"
class="text-sm text-[#ffe4e1] hover:text-white">
View all →
</a>

</div>

<div class="mt-8 space-y-6">

<PostCard post={featured} featured />

{rest.length > 0 && (
<div class="grid gap-6 sm:grid-cols-2">
{rest.map((post) => <PostCard post={post} />)}
</div>
)}

</div>

</>
)}

</section>

</Layout>

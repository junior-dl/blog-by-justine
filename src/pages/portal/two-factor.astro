---
import PortalLayout from "../../layouts/PortalLayout.astro";

export const prerender = false;
---

<PortalLayout title="Two-factor check" bare>
    <p class="uppercase tracking-[.3em] text-[#ffe4e1] text-xs">Step 2 of 2</p>
    <h1 class="mt-3 text-4xl font-black">Enter your code</h1>
    <p class="mt-4 text-slate-400" id="hint">Open your authenticator app and enter the 6-digit code for By Justine.</p>

    <form id="verify" class="card mt-10 space-y-5" novalidate>
        <div id="error" class="error" hidden></div>
        <div>
            <label class="label" for="code" id="code-label">Authenticator code</label>
            <input class="field text-center text-2xl tracking-[.4em]" id="code" name="code"
                inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required autofocus />
        </div>
        <label class="flex items-center gap-3 text-sm text-slate-300">
            <input type="checkbox" id="trust" class="size-4 accent-[#ffe4e1]" />
            Trust this device for 30 days
        </label>
        <button class="btn btn-primary w-full" type="submit">Verify</button>
        <button class="w-full text-sm text-slate-400 hover:text-white" type="button" id="toggle">
            Use a backup code instead
        </button>
    </form>

    <p class="mt-6 text-center text-sm"><a href="/portal/login" class="text-slate-500 hover:text-white">← Back to sign in</a></p>
</PortalLayout>

<script>
    import { authClient } from "../../lib/auth-client";

    const form = document.getElementById("verify") as HTMLFormElement;
    const input = document.getElementById("code") as HTMLInputElement;
    const errorBox = document.getElementById("error")!;
    const toggle = document.getElementById("toggle")!;
    let backup = false;

    toggle.addEventListener("click", () => {
        backup = !backup;
        input.value = "";
        input.maxLength = backup ? 32 : 6;
        input.inputMode = backup ? "text" : "numeric";
        input.className = backup ? "field" : "field text-center text-2xl tracking-[.4em]";
        input.removeAttribute("pattern");
        document.getElementById("code-label")!.textContent = backup ? "Backup code" : "Authenticator code";
        document.getElementById("hint")!.textContent = backup
            ? "Enter one of the backup codes you saved when you set up two-factor. Each code works once."
            : "Open your authenticator app and enter the 6-digit code for By Justine.";
        toggle.textContent = backup ? "Use authenticator code instead" : "Use a backup code instead";
        input.focus();
    });

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const code = input.value.replace(/\s+/g, "");
        if (!code) return;
        const trustDevice = (document.getElementById("trust") as HTMLInputElement).checked;
        const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
        button.disabled = true;
        errorBox.hidden = true;

        const { error } = backup
            ? await authClient.twoFactor.verifyBackupCode({ code, trustDevice })
            : await authClient.twoFactor.verifyTotp({ code, trustDevice });

        button.disabled = false;
        if (error) {
            errorBox.textContent =
                error.status === 429
                    ? "Too many attempts. Wait a minute and try again."
                    : error.status === 401 && /session|cookie/i.test(error.message ?? "")
                      ? "This sign-in expired. Go back and sign in again."
                      : "That code didn't work. Try again.";
            errorBox.hidden = false;
            input.select();
            return;
        }
        location.href = "/portal";
    });
</script>

---
import PortalLayout from "../../layouts/PortalLayout.astro";

export const prerender = false;

const forbidden = Astro.url.searchParams.get("error") === "forbidden";
---

<PortalLayout title="Sign in" bare>
    <p class="uppercase tracking-[.3em] text-[#ffe4e1] text-xs">By Justine</p>
    <h1 class="mt-3 text-4xl font-black">Portal sign in</h1>

    <form id="login" class="card mt-10 space-y-5" novalidate>
        <div id="error" class="error" hidden={!forbidden}>
            {forbidden && "This account is not allowed to use the portal."}
        </div>
        <div>
            <label class="label" for="email">Email</label>
            <input class="field" id="email" name="email" type="email" autocomplete="username" required autofocus />
        </div>
        <div>
            <label class="label" for="password">Password</label>
            <input class="field" id="password" name="password" type="password" autocomplete="current-password" required />
        </div>
        <button class="btn btn-primary w-full" type="submit">Continue</button>
    </form>
</PortalLayout>

<script>
    import { authClient } from "../../lib/auth-client";

    const form = document.getElementById("login") as HTMLFormElement;
    const errorBox = document.getElementById("error")!;
    const showError = (msg: string) => {
        errorBox.textContent = msg;
        errorBox.hidden = false;
    };

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const button = form.querySelector("button")!;
        const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
        const password = (form.elements.namedItem("password") as HTMLInputElement).value;
        if (!email || !password) return showError("Enter your email and password.");

        button.disabled = true;
        errorBox.hidden = true;
        const { data, error } = await authClient.signIn.email({ email, password });
        button.disabled = false;

        if (error) {
            return showError(
                error.status === 429
                    ? "Too many attempts. Wait a minute and try again."
                    : error.status === 401
                      ? "Email or password is incorrect."
                      : `Server error (${error.status ?? "no response"}): ${error.message ?? "check the terminal running pnpm dev"}`,
            );
        }
        location.href = data && "twoFactorRedirect" in data && data.twoFactorRedirect ? "/portal/two-factor" : "/portal";
    });
</script>
